# Base de datos en la nube (BDD_CLOUD). Usar la cadena de conexion de Supabase u otro Postgres.
# Ejemplo Supabase: postgresql+psycopg://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=BDD_CLOUD
ENVIRONMENT=development

# Docker Compose local
POSTGRES_DB=backend_pronoticos
POSTGRES_USER=pronostats
POSTGRES_PASSWORD=

# Seguridad / JWT
# Obligatorio: genera un valor aleatorio de al menos 32 caracteres.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=access_token
# En produccion usar ENVIRONMENT=production y JWT_COOKIE_SECURE=true.
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# CORS (origenes del frontend separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Parametros del motor de pronostico
PREDICTION_MODEL_VERSION=rules-v1
PREDICTION_RECENT_FORM_MATCHES=5
PREDICTION_HOME_ADVANTAGE=0.15
