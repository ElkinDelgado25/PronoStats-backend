# Backend — plantilla para Render / Cloud Run API
ENVIRONMENT=production

DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
# En Render usa siempre el pooler (IPv4). db.*.supabase.co es IPv6 y falla.

JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_DE_32_CARACTERES_MINIMO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=none

CORS_ORIGINS=https://pronostats-frontend-559765823664.us-south1.run.app
FRONTEND_URL=https://pronostats-frontend-559765823664.us-south1.run.app

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_MIN_DEPOSIT=5
STRIPE_ALLOW_CONFIRM_FALLBACK=false

PREDICTION_MODEL_VERSION=rules-v1
PREDICTION_RECENT_FORM_MATCHES=5
PREDICTION_HOME_ADVANTAGE=0.15
PREDICTION_OVERROUND_MARGIN=0.07
