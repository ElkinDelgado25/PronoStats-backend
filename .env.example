# Base de datos en la nube (BDD_CLOUD). Usar la cadena de conexion de Supabase u otro Postgres.
# Ejemplo Supabase: postgresql+psycopg://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=BDD_CLOUD

# Seguridad / JWT
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# CORS (origenes del frontend separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Parametros del motor de pronostico
PREDICTION_MODEL_VERSION=rules-v1
PREDICTION_RECENT_FORM_MATCHES=5
PREDICTION_HOME_ADVANTAGE=0.15
