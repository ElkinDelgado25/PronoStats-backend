# Env Backen
# Base de datos en la nube (BDD_CLOUD). Usar la cadena de conexion de Supabase u otro Postgres.
# Ejemplo Supabase: postgresql+psycopg2://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg://pronostats:pronostats123@localhost:15432/backend_pronoticos

ENVIRONMENT=development

# Docker Compose local
POSTGRES_DB=backend_pronoticos
POSTGRES_USER=pronostats
POSTGRES_PASSWORD=8f3c0e1a9b7d4c2e91f6a0b5d8e3c7a4

# Seguridad / JWT
JWT_SECRET=0e7b9a1d4c6f42b8a93d5f1c2e7a9b4c8d6e0f2a1b3c4d5e6f708192a3b4c5d6
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# CORS (origenes del frontend separados por coma)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Parametros del motor de pronostico
PREDICTION_MODEL_VERSION=rules-v1
PREDICTION_RECENT_FORM_MATCHES=5
PREDICTION_HOME_ADVANTAGE=0.15
PREDICTION_OVERROUND_MARGIN=0.07


# Stripe (cartera) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_MIN_DEPOSIT=5
FRONTEND_URL=http://localhost:5173
STRIPE_ALLOW_CONFIRM_FALLBACK=true

# URL base de la API del backend PronoStats
VITE_API_URL=http://localhost:8001