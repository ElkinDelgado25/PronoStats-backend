# Variables de produccion para Cloud Run (front) + Render (API).
# Pegarlas en la consola del proveedor (Environment Variables).

ENVIRONMENT=production

DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=https://PROJECT_REF.supabase.co

JWT_SECRET=REEMPLAZA_CON_UN_SECRETO_DE_32_CARACTERES_MINIMO
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_COOKIE_NAME=access_token
JWT_COOKIE_SECURE=true
JWT_COOKIE_SAMESITE=none

# Frontend Cloud Run
CORS_ORIGINS=https://pronostats-frontend-559765823664.us-south1.run.app
FRONTEND_URL=https://pronostats-frontend-559765823664.us-south1.run.app

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
